{* T-Shirt eCommerce Designer Template - FIXED VERSION *}
{* Copy this to: views/templates/front/designer.tpl *}

<div class="tshirtecommerce-designer-page">

{if isset($has_product) && $has_product}
    {* Product loaded successfully - show designer *}

    <div class="bootstrap">
        {if isset($error) && $error != ''}
            <div class="alert alert-warning">
                {$error}
            </div>
        {else}
            <div class="tshirtecommerce-container">
                {$tshirtecommerce_content nofilter}
            </div>
        {/if}

        <div id="tshirtecommerce-dg-mask" class="tshirtecommerce-loading" style="display: none;">
            <div class="loading-spinner">
                <img src="{$logo_loading}" alt="{$text_loading}" />
                <p>{$text_loading}</p>
            </div>
        </div>
    </div>

    {* CSS Files *}
    <link href="{$url_mobile}" rel="stylesheet" type="text/css" />
    <link href="{$url_mobile_css}" rel="stylesheet" type="text/css" />
    <link href="{$url_prestashop_css}" rel="stylesheet" type="text/css" />

    {* JavaScript Variables *}
    <script type="text/javascript">
        // PrestaShop variables
        var ps_product_id = {$ps_product_id|intval};
        var ps_language_id = {$ps_language_id|intval};
        var ps_shop_id = {$ps_shop_id|intval};
        var ps_id_customer = {$ps_id_customer|intval};
        var ps_id_currency = {$ps_id_currency|intval};
        var ps_id_country = {$ps_id_country|intval};
        var ps_id_group = {$ps_id_group|intval};

        // Links
        var ps_link_register_account = '{$link_register_account|escape:'javascript'}';
        var ps_link_forgot_password = '{$link_forgot_password|escape:'javascript'}';
        var ps_link_shopping_cart = '{$link_shopping_cart|escape:'javascript'}';

        // Designer URLs
        var urlBack = '{$url_back|escape:'javascript'}';
        var urlDesign = '{$url_designer|escape:'javascript'}';
        var urlDesignload = '{$urlDesignload|escape:'javascript'}';
        var urlTshirtecommermceApi = '{$url_api|escape:'javascript'}';

        // Settings
        var tshirtecommerce_cart_ajax = '{$tshirtecommerce_cart_ajax}';
        var tshirtecommerce_cart_ajax_msg = '{$tshirtecommerce_cart_ajax_msg|escape:'javascript'}';
        var tshirtecommerce_mobile_full = '{$tshirtecommerce_mobile_full}';
        var logo_loading = '{$logo_loading|escape:'javascript'}';
        var text_loading = '{$text_loading|escape:'javascript'}';
        var url_regiter_ps = '{$link_register_account|escape:'javascript'}';
    </script>

    {* Load designer if URL available *}
    {if $urlDesignload != ''}
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function() {
            // Load designer iframe or content
            var container = document.getElementById('tshirtecommerce-designer-container');
            if (container && urlDesignload) {
                console.log('Loading designer from:', urlDesignload);
                var iframe = document.createElement('iframe');
                iframe.src = urlDesignload;
                iframe.style.width = '100%';
                iframe.style.height = '800px';
                iframe.style.border = 'none';
                container.appendChild(iframe);
            }
        });
    </script>
    {/if}

{else}
    {* No product available - show error *}

    <div class="bootstrap">
        <div class="alert alert-danger">
            <h4>{l s='Designer Not Available' mod='tshirtecommerce'}</h4>

            {if isset($error) && $error != ''}
                <p>{$error}</p>
            {else}
                <p>{l s='No designer product configured.' mod='tshirtecommerce'}</p>
            {/if}

            <hr />

            <p><strong>{l s='To fix this issue:' mod='tshirtecommerce'}</strong></p>
            <ol>
                <li>{l s='Go to your database (phpMyAdmin)' mod='tshirtecommerce'}</li>
                <li>{l s='Run this query:' mod='tshirtecommerce'}
                    <pre style="background:#f5f5f5;padding:10px;margin:10px 0;">UPDATE ps_product SET design_product_id = 'test_design_123' WHERE id_product = 1;</pre>
                </li>
                <li>{l s='Then set default product in module configuration:' mod='tshirtecommerce'}
                    <pre style="background:#f5f5f5;padding:10px;margin:10px 0;">UPDATE ps_configuration SET value = '1::1' WHERE name = 'TSHIRTECOMMERCE_DOWNLOADABLE';</pre>
                </li>
                <li>{l s='Refresh this page' mod='tshirtecommerce'}</li>
            </ol>

            <p><a href="{$url}admin" class="btn btn-primary">{l s='Go to Admin Panel' mod='tshirtecommerce'}</a></p>
        </div>
    </div>

{/if}

</div>

<style>
.tshirtecommerce-designer-page {
    width: 100%;
    min-height: 600px;
}
.tshirtecommerce-container {
    width: 100%;
    position: relative;
}
.tshirtecommerce-loading {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.7);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
}
.loading-spinner {
    text-align: center;
    color: white;
}
.loading-spinner img {
    max-width: 64px;
}
</style>
