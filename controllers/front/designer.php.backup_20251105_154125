<?php
 /**
  * Front Controller for T-Shirt Designer
  * PS9 Compatible Version
  */

  if (!defined('_PS_VERSION_')) {
    exit;
  }

  class TshirtecommerceDesignerModuleFrontController extends ModuleFrontController
  {
      protected $product;
      public $display_column_left = false;
      public $display_column_right = false;

      public function __construct()
      {
          parent::__construct();

          if (Configuration::get('PS_SSL_ENABLED')) {
              $this->ssl = true;
          }

          $this->display_column_left = false;
          $this->display_column_right = false;
      }

      public function initContent()
      {
          parent::initContent();

          // PS9: No manual session_start needed - PrestaShop handles it
          // Store customer info in Smarty for JS access if needed
          if ($this->context->customer->logged) {
              $this->context->smarty->assign('customer_logged', true);
              $this->context->smarty->assign('customer_info', [
                  'login' => 1,
                  'email' => $this->context->customer->email,
                  'id' => $this->context->customer->id
              ]);
          }

          $url = Tools::usingSecureMode() ? Tools::getShopDomainSsl(true)
   : Tools::getShopDomain(true);
          $url .= __PS_BASE_URI__;

          $check = false;
          $error = '';
          $content = '';
          $urlDesignload = '';
          $design_product_id = '';
          $product_id = 0;
          $parent_id = 0;

          // Check if product specified, else get default
          if (!Tools::getIsset('product_id') &&
  !Tools::getIsset('parent_id')) {
              $setting_tmp_str =
  Configuration::get('TSHIRTECOMMERCE_DOWNLOADABLE');
              $setting_tmp = explode('::', $setting_tmp_str);
              $tshirtecommerce_product_default = isset($setting_tmp[0]) ?
   $setting_tmp[0] : '';

              if (!empty($tshirtecommerce_product_default) &&
  (int)$tshirtecommerce_product_default > 0) {
                  $parent_id = (int)$tshirtecommerce_product_default;
                  $product_id = Db::getInstance()->getValue(
                      'SELECT `design_product_id`
                      FROM `'._DB_PREFIX_.'product`
                      WHERE `id_product` = '.(int)$parent_id
                  );
              } else {
                  // FIXED: Proper SQL query without backtick issues
                  $products_linked = Db::getInstance()->executeS(
                      'SELECT `id_product`, `design_product_id` 
                      FROM `'._DB_PREFIX_.'product` 
                      WHERE `design_product_id` <> "" 
                      AND `design_product_id` IS NOT NULL 
                      AND `design_product_id` NOT LIKE "%::%" 
                      LIMIT 1'
                  );

                  // FIXED: Check if array is valid before accessing
                  if (!empty($products_linked) &&
  is_array($products_linked) && isset($products_linked[0])) {
                      $product_id =
  $products_linked[0]['design_product_id'];
                      $parent_id =
  (int)$products_linked[0]['id_product'];
                  } else {
                      // No products found - show error message
                      $product_id = 0;
                      $parent_id = 0;
                      $error = $this->module->trans('No design products 
  configured. Please configure products in the module settings first.',
  [], 'Modules.Tshirtecommerce.Shop');
                  }
              }
          } else {
              // Get GET arguments
              if (Tools::getIsset('product_id')) {
                  $product_id = Tools::getValue('product_id');
              } elseif (Tools::getIsset('design')) {
                  $product_id = Tools::getValue('design');
              }

              if (Tools::getIsset('parent_id')) {
                  $parent_id = (int)Tools::getValue('parent_id');
              }
          }

          $cart_id = Tools::getIsset('cart_id') ?
  Tools::getValue('cart_id') : null;
          $color = Tools::getIsset('color') ? Tools::getValue('color') :
  null;

          // Process product_id string
          $product_id_str = explode(':', $product_id);
          if (count($product_id_str) > 1 && isset($product_id_str[0]) &&
  isset($product_id_str[1]) && isset($product_id_str[2]) &&
  isset($product_id_str[3])) {
              $urlDesignload = $url.'tshirtecommerce/index.php?product='.
  $product_id_str[2].'&color='.$product_id_str[3].'&user='.$product_id_str[0].'&id='.$product_id_str[1];
              if (isset($product_id_str[4])) {
                  $urlDesignload .= '&parent='.$product_id_str[4];
              } else {
                  $urlDesignload .= '&parent='.$parent_id;
              }
              $content = '<div class="row-designer"></div>';
          } else {
              if ($product_id > 0 && $parent_id > 0) {
                  $check = true;
              }

              if ($check === true) {
                  $content = '<div class="row-designer"></div>';

                  // Get data from ps_product table
                  $settings =
  Db::getInstance(_PS_USE_SQL_SLAVE_)->executeS(
                      'SELECT `design_product_id` 
                      FROM `'._DB_PREFIX_.'product` 
                      WHERE `id_product` = '.(int)$parent_id
                  );

                  if (isset($settings[0]) &&
  isset($settings[0]['design_product_id'])) {
                      $design_product_id =
  $settings[0]['design_product_id'];
                  }

                  $params = explode(':', $design_product_id);
                  if (count($params) > 1) {
                      if ($product_id != $params[2]) {
                          $error = $this->module->trans('Design Not 
  Found.', [], 'Modules.Tshirtecommerce.Shop');
                          $urlDesignload = '';
                      } else {
                          $urlDesignload =
  $url.'tshirtecommerce/index.php?product='.$params[2].'&color='.$params[
  3].'&user='.$params[0].'&id='.$params[1].'&parent='.$parent_id;
                          if (isset($cart_id)) {
                              $urlDesignload .= '&cart_id='.$cart_id;
                          }
                      }
                  } else {
                      if ($product_id != $design_product_id) {
                          $error = $this->module->trans('Design Not 
  Found.', [], 'Modules.Tshirtecommerce.Shop');
                          $urlDesignload = '';
                      } else {
                          $urlDesignload = $url.'tshirtecommerce/index.ph
  p?product='.$product_id.'&parent='.$parent_id;
                          if (isset($cart_id)) {
                              $urlDesignload .= '&cart_id='.$cart_id;
                          }
                      }
                  }
              } else {
                  $error = $this->module->trans('Product Not Found.', [],
   'Modules.Tshirtecommerce.Shop');
              }
          }

          if ($parent_id > 0) {
              $this->product = new Product($parent_id, true,
  $this->context->language->id, $this->context->shop->id);

              // Check if product exists
              if ($this->product->id == null || empty($this->product->id)
   || (int)$this->product->id == 0) {
                  $error = $this->module->trans('Product Not Found.', [],
   'Modules.Tshirtecommerce.Shop');
                  $this->product = null;
              } else {
                  $this->product->customization_required = false;
                  $customization_fields = $this->product->customizable ?
  $this->product->getCustomizationFields($this->context->language->id) :
  false;

                  if (is_array($customization_fields)) {
                      foreach ($customization_fields as
  $customization_field) {
                          if ($this->product->customization_required =
  $customization_field['required']) {
                              break;
                          }
                      }
                  }

                  // Assign price and attributes
                  $this->assignPriceAndTax();
                  $this->assignAttributesGroups();
                  $this->assignAttributesCombinations();
              }
          }

          // Get customer group
          $id_group = null;
          if ($this->context->customer->id) {
              $id_group =
  Customer::getDefaultGroupId((int)$this->context->customer->id);
          }

          if (!$id_group) {
              $id_group = (int)Group::getCurrent()->id;
          }

          $logo_loading_default =
  $url.'/tshirtecommerce/assets/images/logo-loading.png';
          $logo_loading =
  Configuration::get('TSHIRTECOMMERCE_LOGO_LOADING') ?
  $url.Configuration::get('TSHIRTECOMMERCE_LOGO_LOADING') :
  $logo_loading_default;
          $text_loading =
  Configuration::get('TSHIRTECOMMERCE_TEXT_LOADING') ?
  Configuration::get('TSHIRTECOMMERCE_TEXT_LOADING') :
  $this->module->trans('Loading...', [], 'Modules.Tshirtecommerce.Shop');

          $url_regiter_ps =
  $this->context->link->getPageLink('my-account', true,
  $this->context->language->id, null, false, $this->context->shop->id);
          $url_appjs = $url.'/tshirtecommerce/prestashop/js/app17.js';

          $tshirtecommerce_mobile_full =
  Configuration::get('TSHIRTECOMMERCE_FULL_MOBILE_LAYOUT');
          if ($tshirtecommerce_mobile_full == null) {
              $tshirtecommerce_mobile_full = 0;
          }

          $tshirtecommerce_cart_ajax =
  Configuration::get('TSHIRTECOMMERCE_CART_AJAX');
          if ($tshirtecommerce_cart_ajax == null) {
              $tshirtecommerce_cart_ajax = 1;
          }

          // Assign params to view
          $this->context->smarty->assign(array(
              'tshirtecommerce_cart_ajax_msg' =>
  $this->module->trans('Product added to your shopping cart. Do you want 
  to continue shopping?', [], 'Modules.Tshirtecommerce.Shop'),
              'tshirtecommerce_cart_ajax' => $tshirtecommerce_cart_ajax,
              'tshirtecommerce_mobile_full' =>
  $tshirtecommerce_mobile_full,
              'product' => ($this->product !== null) ? $this->product :
  array(),
              'outOfStockAllowed' =>
  (int)Configuration::get('PS_ORDER_OUT_OF_STOCK'),
              'display_discount_price' =>
  Configuration::get('PS_DISPLAY_DISCOUNT_PRICE'),
              'customizationFields' => isset($customization_fields) ?
  $customization_fields : array(),
              'token' => Tools::getToken(false),
              'error' => $error,
              'tshirtecommerce_content' => $content,
              'url' => $url,
              'url_mobile' =>
  $url.'/tshirtecommerce/assets/css/mobile.css',
              'url_mobile_css' =>
  $url.'/tshirtecommerce/prestashop/css/mobile.css',
              'url_prestashop_css' =>
  $url.'/tshirtecommerce/assets/css/prestashop.css',
              'url_back' => ($this->product !== null) ?
  $this->context->link->getProductLink($this->product) : $url,
              'url_designer' =>
  $this->context->link->getModuleLink('tshirtecommerce', 'designer'),
              'url_api' => $url.'modules/tshirtecommerce/ajax.php',
              'url_appjs' => $url_appjs,
              'urlDesignload' => $urlDesignload,
              'ps_language_id' => $this->context->language->id,
              'ps_shop_id' => $this->context->shop->id,
              'ps_product_id' => $parent_id,
              'ps_id_product_attribute' => '',
              'ps_id_customization' => '',
              'ps_id_address_delivery' => '',
              'ps_id_currency' => $this->context->currency->id,
              'ps_id_customer' => $this->context->customer->id,
              'ps_id_country' => $this->context->country->id,
              'ps_id_group' => $id_group,
              'link_register_account' =>
  $this->context->link->getPageLink('my-account', true),
              'link_forgot_password' =>
  $this->context->link->getPageLink('password', true),
              'link_shopping_cart' =>
  $this->context->link->getPageLink('order'),
              'logo_loading' => $logo_loading,
              'text_loading' => $text_loading,
              'url_regiter_ps' => $url_regiter_ps,
          ));

          // PS9: Use module: syntax for template path
          $this->setTemplate('module:tshirtecommerce/views/templates/fron
  t/designer.tpl');
      }

      // Keep all other methods from original file...
      // (assignPriceAndTax, assignAttributesGroups, assignAttributesCombinations, etc.)
	protected function get_attributes_ps()
	{
		$pscolors = array();
        $groups = array();
        $pscombinations = array();
        $combination_images = array();
        $attributes_groups = $this->product->getAttributesGroups($this->context->language->id);

        if (is_array($attributes_groups) && $attributes_groups) {
            $combination_images = $this->product->getCombinationImages($this->context->language->id);
            $combination_prices_set = array();

            foreach ($attributes_groups as $k => $row) {
                // Color management
                if (isset($row['is_color_group']) && $row['is_color_group'] && (isset($row['attribute_color']) && $row['attribute_color']) ||
                    (file_exists(_PS_COL_IMG_DIR_.$row['id_attribute'].'.jpg'))) {
                    $pscolors[$row['id_attribute']]['value'] = $row['attribute_color'];
                    $pscolors[$row['id_attribute']]['name'] = $row['attribute_name'];
                    if (!isset($pscolors[$row['id_attribute']]['attributes_quantity'])) $pscolors[$row['id_attribute']]['attributes_quantity'] = 0;
                    $pscolors[$row['id_attribute']]['attributes_quantity'] += (int)$row['quantity'];
                }
                if (!isset($groups[$row['id_attribute_group']])) {
                    $groups[$row['id_attribute_group']] = array(
                        'group_name' => $row['group_name'],
                        'name' => $row['public_group_name'],
                        'group_type' => $row['group_type'],
                        'default' => -1,
                    );
                }
                $groups[$row['id_attribute_group']]['attributes'][$row['id_attribute']] = $row['attribute_name'];
                if ($row['default_on'] && $groups[$row['id_attribute_group']]['default'] == -1) $groups[$row['id_attribute_group']]['default'] = (int)$row['id_attribute'];
                if (!isset($groups[$row['id_attribute_group']]['attributes_quantity'][$row['id_attribute']])) $groups[$row['id_attribute_group']]['attributes_quantity'][$row['id_attribute']] = 0;
                $groups[$row['id_attribute_group']]['attributes_quantity'][$row['id_attribute']] += (int)$row['quantity'];
                $pscombinations[$row['id_product_attribute']]['attributes_values'][$row['id_attribute_group']] = $row['attribute_name'];
                $pscombinations[$row['id_product_attribute']]['attributes'][] = (int)$row['id_attribute'];
                $pscombinations[$row['id_product_attribute']]['price'] = (float)Tools::convertPriceFull($row['price'], null, Context::getContext()->currency);
                // Call getPriceStatic in order to set $combination_specific_price
                if (!isset($combination_prices_set[(int)$row['id_product_attribute']])) {
                    Product::getPriceStatic((int)$this->product->id, false, $row['id_product_attribute'], 6, null, false, true, 1, false, null, null, null, $combination_specific_price);
                    $combination_prices_set[(int)$row['id_product_attribute']] = true;
                    $pscombinations[$row['id_product_attribute']]['specific_price'] = $combination_specific_price;
                }
                $pscombinations[$row['id_product_attribute']]['ecotax'] = (float)$row['ecotax'];
                $pscombinations[$row['id_product_attribute']]['weight'] = (float)$row['weight'];
                $pscombinations[$row['id_product_attribute']]['quantity'] = (int)$row['quantity'];
                $pscombinations[$row['id_product_attribute']]['reference'] = $row['reference'];
                $pscombinations[$row['id_product_attribute']]['unit_impact'] = Tools::convertPriceFull($row['unit_price_impact'], null, Context::getContext()->currency);
                $pscombinations[$row['id_product_attribute']]['minimal_quantity'] = $row['minimal_quantity'];
                if ($row['available_date'] != '0000-00-00' && Validate::isDate($row['available_date'])) {
                    $pscombinations[$row['id_product_attribute']]['available_date'] = $row['available_date'];
                    $pscombinations[$row['id_product_attribute']]['date_formatted'] = Tools::displayDate($row['available_date'], Context::getContext()->language->id);
                } else {
                    $pscombinations[$row['id_product_attribute']]['available_date'] = $pscombinations[$row['id_product_attribute']]['date_formatted'] = '';
                }
                if (!isset($combination_images[$row['id_product_attribute']][0]['id_image'])) {
                    $pscombinations[$row['id_product_attribute']]['id_image'] = -1;
                } else {
                    $pscombinations[$row['id_product_attribute']]['id_image'] = $id_image = (int)$combination_images[$row['id_product_attribute']][0]['id_image'];
                    if ($row['default_on']) {
                        if (isset($this->context->smarty->tpl_vars['cover']->value)) $current_cover = $this->context->smarty->tpl_vars['cover']->value;
                        if (is_array($combination_images[$row['id_product_attribute']])) {
                            foreach ($combination_images[$row['id_product_attribute']] as $tmp) {
                                if (isset($current_cover['id_image']) && $tmp['id_image'] == $current_cover['id_image']) {
                                    $pscombinations[$row['id_product_attribute']]['id_image'] = $id_image = (int)$tmp['id_image'];
                                    break;
                                }
                            }
                        }
                        if ($id_image > 0) {
                            if (isset($this->context->smarty->tpl_vars['images']->value)) $product_images = $this->context->smarty->tpl_vars['images']->value;
                            if (isset($product_images) && is_array($product_images) && isset($product_images[$id_image])) {
                                $product_images[$id_image]['cover'] = 1;
                                $this->context->smarty->assign('mainImage', $product_images[$id_image]);
                                if (count($product_images)) $this->context->smarty->assign('images', $product_images);
                            }
                            if (isset($this->context->smarty->tpl_vars['cover']->value)) $cover = $this->context->smarty->tpl_vars['cover']->value;
                            if (isset($cover) && is_array($cover) && isset($product_images) && is_array($product_images)) {
                                $product_images[$cover['id_image']]['cover'] = 0;
                                if (isset($product_images[$id_image])) $cover = $product_images[$id_image];
                                $cover['id_image'] = (Configuration::get('PS_LEGACY_IMAGES') ? ($this->product->id.'-'.$id_image) : (int)$id_image);
                                $cover['id_image_only'] = (int)$id_image;
                                $this->context->smarty->assign('cover', $cover);
                            }
                        }
                    }
                }
            }
            // wash attributes list (if some attributes are unavailables and if allowed to wash it)
            if (!Product::isAvailableWhenOutOfStock($this->product->out_of_stock) && Configuration::get('PS_DISP_UNAVAILABLE_ATTR') == 0) {
                foreach ($groups as &$group) {
                    foreach ($group['attributes_quantity'] as $key => &$quantity) {
                        if ($quantity <= 0) unset($group['attributes'][$key]);
                    }
                }
                foreach ($pscolors as $key => $color) {
                    if ($color['attributes_quantity'] <= 0) unset($pscolors[$key]);
                }
            }
            foreach ($pscombinations as $id_product_attribute => $comb) {
                $attribute_list = '';

                foreach ($comb['attributes'] as $id_attribute) {
                    $attribute_list .= '\''.(int)$id_attribute.'\',';
                }

                $attribute_list = rtrim($attribute_list, ',');
                $pscombinations[$id_product_attribute]['list'] = $attribute_list;
            }
        }

        return array(
        	'groups' => $groups,
            'colors' => (count((array)$pscolors)) ? $pscolors : false,
            'combinations' => $pscombinations,
            'combinationImages' => $combination_images
        );
	}

    protected function addJsDef($js_def, $array = array())
    {
        if (is_array($js_def)) {
            foreach ($js_def as $key => $js) {
                $array[$key] = $js;
            }
        } elseif ($js_def) {
            $array[] = $js_def;
        }
    }

    /**
     * Assign template vars related to attribute groups and colors
     */
    protected function assignAttributesGroups()
    {
        $arr_attrs = $this->get_attributes_ps();
        $groups = $arr_attrs['groups'];
        $pscolors = $arr_attrs['colors'];
        $combinations = $arr_attrs['combinations'];
        $combination_images = $arr_attrs['combinationImages'];

        $this->context->smarty->assign(array(
            'groups' => $groups,
            'colors' => (count((array)$pscolors)) ? $pscolors : false,
            'combinations' => $combinations,
            'combinationImages' => $combination_images
        ));
    }

    /**
     * Get and assign attributes combinations informations
     */
    protected function assignAttributesCombinations()
    {
        $attributes_combinations = Product::getAttributesInformationsByProduct($this->product->id);
        if (is_array($attributes_combinations) && count($attributes_combinations)) {
            foreach ($attributes_combinations as &$ac) {
                foreach ($ac as &$val) {
                    $val = str_replace(Configuration::get('PS_ATTRIBUTE_ANCHOR_SEPARATOR'), '_', Tools::link_rewrite(str_replace(array(',', '.'), '-', $val)));
                }
            }
        } else {
            $attributes_combinations = array();
        }
        $this->context->smarty->assign(array(
            'attributesCombinations' =>  $attributes_combinations,
            'attribute_anchor_separator' => Configuration::get('PS_ATTRIBUTE_ANCHOR_SEPARATOR')
            )
        );
    }

    protected function stringInsert($str, $insertstr = '', $pos = 0)
    {
        $str = substr($str, 0, $pos).$insertstr.substr($str, $pos);
        return $str;
    }

    protected function assignPriceAndTax()
    {
    	$id_customer = (isset($this->context->customer) ? (int)$this->context->customer->id : 0);
        $id_group = (int)Group::getCurrent()->id;
        // PrestaShop 9 always uses Tools::getCountry()
        $id_country = $id_customer ? (int)Customer::getCurrentCountry($id_customer) : (int)Tools::getCountry();

        $group_reduction = GroupReduction::getValueForProduct($this->product->id, $id_group);
        if ($group_reduction === false) $group_reduction = Group::getReduction((int)$this->context->cookie->id_customer) / 100;
        /* Tax */
        $tax = (float)$this->product->getTaxesRate(new Address((int)$this->context->cart->{Configuration::get('PS_TAX_ADDRESS_TYPE')}));
        $this->context->smarty->assign('tax_rate', $tax);
        $product_price_with_tax = Product::getPriceStatic($this->product->id, true, null, 6);
        if (Product::$_taxCalculationMethod == PS_TAX_INC) $product_price_with_tax = Tools::ps_round($product_price_with_tax, 2);
        $product_price_without_eco_tax = (float)$product_price_with_tax - $this->product->ecotax;
        $ecotax_rate = (float)Tax::getProductEcotaxRate($this->context->cart->{Configuration::get('PS_TAX_ADDRESS_TYPE')});
        $ecotax_tax_amount = Tools::ps_round($this->product->ecotax, 2);
        if (Product::$_taxCalculationMethod == PS_TAX_INC && (int)Configuration::get('PS_TAX')) {
            $ecotax_tax_amount = Tools::ps_round($ecotax_tax_amount * (1 + $ecotax_rate / 100), 2);
        }
        $id_currency = (int)$this->context->cookie->id_currency;
        $id_product = (int)$this->product->id;
        $id_shop = $this->context->shop->id;
        $quantity_discounts = SpecificPrice::getQuantityDiscounts($id_product, $id_shop, $id_currency, $id_country, $id_group, null, true, (int)$this->context->customer->id);
        foreach ($quantity_discounts as &$quantity_discount) {
            if ($quantity_discount['id_product_attribute']) {
                $combination = new Combination((int)$quantity_discount['id_product_attribute']);
                $attributes = $combination->getAttributesName((int)$this->context->language->id);
                foreach ($attributes as $attribute) $quantity_discount['attributes'] = $attribute['name'].' - ';
                $quantity_discount['attributes'] = rtrim($quantity_discount['attributes'], ' - ');
            }
            if ((int)$quantity_discount['id_currency'] == 0 && $quantity_discount['reduction_type'] == 'amount') {
                $quantity_discount['reduction'] = Tools::convertPriceFull($quantity_discount['reduction'], null, Context::getContext()->currency);
            }
        }
        $product_price 	= $this->product->getPrice(Product::$_taxCalculationMethod == PS_TAX_INC, false);
        $address = new Address($this->context->cart->{Configuration::get('PS_TAX_ADDRESS_TYPE')});
        $this->context->smarty->assign(array(
            'quantity_discounts' => $this->formatQuantityDiscounts($quantity_discounts, $product_price, (float)$tax, $ecotax_tax_amount),
            'ecotax_tax_inc' => $ecotax_tax_amount,
            'ecotax_tax_exc' => Tools::ps_round($this->product->ecotax, 2),
            'ecotaxTax_rate' => $ecotax_rate,
            'productPriceWithoutEcoTax' => (float)$product_price_without_eco_tax,
            'group_reduction' => $group_reduction,
            'no_tax' => Tax::excludeTaxeOption() || !$this->product->getTaxesRate($address),
            'ecotax' => (!count($this->errors) && $this->product->ecotax > 0 ? Tools::convertPrice((float)$this->product->ecotax) : 0),
            'tax_enabled' => Configuration::get('PS_TAX') && !Configuration::get('AEUC_LABEL_TAX_INC_EXC'),
            'customer_group_without_tax' => Group::getPriceDisplayMethod($this->context->customer->id_default_group),
        ));
    }

    protected function getCountry($address = null)
    {
        $id_country = (int)Tools::getValue('id_country');
        if ($id_country && Validate::isInt($id_country)) {
            return (int)$id_country;
        } elseif (!$id_country && isset($address) && isset($address->id_country) && $address->id_country) {
            $id_country = (int)$address->id_country;
        } elseif (Configuration::get('PS_DETECT_COUNTRY') && isset($_SERVER['HTTP_ACCEPT_LANGUAGE'])) {
            preg_match('#(?<=-)\w\w|\w\w(?!-)#', $_SERVER['HTTP_ACCEPT_LANGUAGE'], $array);
            if (is_array($array) && isset($array[0]) && Validate::isLanguageIsoCode($array[0])) {
                $id_country = (int)Country::getByIso($array[0], true);
            }
        }
        if (!isset($id_country) || !$id_country) {
            $id_country = (int)Configuration::get('PS_COUNTRY_DEFAULT');
        }
        return (int)$id_country;
    }

    protected function formatQuantityDiscounts($specific_prices, $price, $tax_rate, $ecotax_amount)
    {
        foreach ($specific_prices as $key => &$row) {
            $row['quantity'] = &$row['from_quantity'];
            if ($row['price'] >= 0) {
                // The price may be directly set
                $cur_price = (!$row['reduction_tax'] ? $row['price'] : $row['price'] * (1 + $tax_rate / 100)) + (float)$ecotax_amount;
                if ($row['reduction_type'] == 'amount') {
                    $cur_price -= ($row['reduction_tax'] ? $row['reduction'] : $row['reduction'] / (1 + $tax_rate / 100));
                    $row['reduction_with_tax'] = $row['reduction_tax'] ? $row['reduction'] : $row['reduction'] / (1 + $tax_rate / 100);
                } else {
                    $cur_price *= 1 - $row['reduction'];
                }
                $row['real_value'] = $price > 0 ? $price - $cur_price : $cur_price;
            } else {
                if ($row['reduction_type'] == 'amount') {
					if (Product::$_taxCalculationMethod == PS_TAX_INC) {
						$row['real_value'] = $row['reduction_tax'] == 1 ? $row['reduction'] : $row['reduction'] * (1 + $tax_rate / 100);
					} else {
						$row['real_value'] = $row['reduction_tax'] == 0 ? $row['reduction'] : $row['reduction'] / (1 + $tax_rate / 100);
					}
                    $row['reduction_with_tax'] = $row['reduction_tax'] ? $row['reduction'] : $row['reduction'] +  ($row['reduction'] *$tax_rate) / 100;
                } else {
                    $row['real_value'] = $row['reduction'] * 100;
                }
            }
            $row['nextQuantity'] = (isset($specific_prices[$key + 1]) ? (int)$specific_prices[$key + 1]['from_quantity'] : - 1);
        }
        return $specific_prices;
    }

    protected function isSessionStarted()
    {
        if (php_sapi_name() !== 'cli') {
            if (version_compare(phpversion(), '5.4.0', '>='))
                return session_status() === PHP_SESSION_ACTIVE ? true : false;
            else
                return session_id() === '' ? false : true;
        }
        return false;
    }
